diff --git a/ap/components/bk_peripheral/src/tp/tp_cst7xx.c b/ap/components/bk_peripheral/src/tp/tp_cst7xx.c
new file mode 100644
index 0000000..d193808
--- /dev/null
+++ b/ap/components/bk_peripheral/src/tp/tp_cst7xx.c
@@ -0,0 +1,259 @@
+// Copyright 2020-2021 Beken
+//
